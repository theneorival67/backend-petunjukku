// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
 directUrl = env("DIRECT_URL")
}

model User {
  id       String   @id @db.Uuid
  name     String?
  email    String   @unique
  role     UserRole @default(teacher)
  isActive Boolean  @default(true) @map("is_active")

  teacherProfile    TeacherProfile?
  rppProjects       RppProject[]
  generatedRpps     GeneratedRpp[]
  exportedDocuments ExportedDocument[]
  ragRetrievalLogs  RagRetrievalLog[]
  kinaChats         KinaChat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model School {
  id            String  @id @default(uuid()) @db.Uuid
  name          String
  npsn          String?
  province      String?
  city          String?
  district      String?
  address       String?
  googlePlaceId String? @map("google_place_id")
  latitude      Float?
  longitude     Float?

  schoolLevel SchoolLevel? @map("school_level")
  schoolType  SchoolType?  @map("school_type")

  schoolEnvironment   String? @map("school_environment")
  availableFacilities Json?   @map("available_facilities")
  internetAccess      String? @map("internet_access")
  localContext        String? @map("local_context")

  teacherProfiles  TeacherProfile[]
  rppProjects      RppProject[]
  environmentScans SchoolEnvironmentScan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schools")
}

model SchoolEnvironmentScan {
  id String @id @default(uuid()) @db.Uuid

  schoolId String? @map("school_id") @db.Uuid
  cacheKey String  @unique @map("cache_key")

  latitude     Float
  longitude    Float
  radiusMeters Int    @map("radius_meters")
  payload      Json
  source       String

  fetchedAt DateTime @map("fetched_at")
  expiresAt DateTime @map("expires_at")

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([schoolId])
  @@index([expiresAt])
  @@map("school_environment_scans")
}

model TeacherProfile {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @unique @map("user_id") @db.Uuid
  schoolId String? @map("school_id") @db.Uuid

  fullName                String  @map("full_name")
  phone                   String?
  position                String?
  educationLevel          String? @map("education_level")
  teachingExperienceYears Int?    @map("teaching_experience_years")
  bio                     String?
  /**
   * Identitas + percakapan onboarding (JSON) — sumber tunggal konteks mengajar
   */
  teachingContext         Json?   @map("teaching_context")
  onboardingCompleted     Boolean @default(false) @map("onboarding_completed")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)

  subjects    TeacherSubject[]
  classes     TeacherClass[]
  rppProjects RppProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teacher_profiles")
}

model TeacherSubject {
  id               String @id @default(uuid()) @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid

  subjectName String  @map("subject_name")
  phase       String?
  gradeLevel  String? @map("grade_level")

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  rppProjects    RppProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teacher_subjects")
}

model TeacherClass {
  id               String @id @default(uuid()) @db.Uuid
  teacherProfileId String @map("teacher_profile_id") @db.Uuid

  className    String  @map("class_name")
  gradeLevel   String  @map("grade_level")
  academicYear String? @map("academic_year")
  studentCount Int?    @map("student_count")

  studentCharacteristics String? @map("student_characteristics")
  learningChallenges     Json?   @map("learning_challenges")
  dominantLearningStyle  String? @map("dominant_learning_style")

  teacherProfile TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  rppProjects    RppProject[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("teacher_classes")
}

model RppProject {
  id String @id @default(uuid()) @db.Uuid

  userId           String  @map("user_id") @db.Uuid
  teacherProfileId String  @map("teacher_profile_id") @db.Uuid
  schoolId         String? @map("school_id") @db.Uuid
  teacherSubjectId String? @map("teacher_subject_id") @db.Uuid
  teacherClassId   String? @map("teacher_class_id") @db.Uuid

  title           String
  rppType         RppType   @map("rpp_type")
  subject         String
  phase           String?
  gradeLevel      String?   @map("grade_level")
  topic           String?
  totalJp         Int?      @map("total_jp")
  meetingCount    Int?      @map("meeting_count")
  semester        String?
  classConditions String?   @map("class_conditions")
  status          RppStatus @default(draft)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherProfile TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  school         School?         @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  teacherSubject TeacherSubject? @relation(fields: [teacherSubjectId], references: [id], onDelete: SetNull)
  teacherClass   TeacherClass?   @relation(fields: [teacherClassId], references: [id], onDelete: SetNull)

  stages            RppStage[]
  generatedRpps     GeneratedRpp[]
  exportedDocuments ExportedDocument[]
  ragRetrievalLogs  RagRetrievalLog[]
  kinaChats         KinaChat[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rpp_projects")
}

model RppStage {
  id           String @id @default(uuid()) @db.Uuid
  rppProjectId String @map("rpp_project_id") @db.Uuid

  stageNumber Int     @map("stage_number")
  stageName   String  @map("stage_name")
  contentJson Json?   @map("content_json")
  isCompleted Boolean @default(false) @map("is_completed")

  rppProject RppProject @relation(fields: [rppProjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rppProjectId, stageNumber])
  @@map("rpp_stages")
}

model KinaChat {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  rppProjectId String?  @map("rpp_project_id") @db.Uuid
  role         ChatRole
  content      String
  metadata     Json?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppProject RppProject? @relation(fields: [rppProjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([rppProjectId, createdAt])
  @@map("kina_chats")
}

model GeneratedRpp {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  rppProjectId    String           @map("rpp_project_id") @db.Uuid
  contentJson     Json             @map("content_json")
  contentMarkdown String?          @map("content_markdown")
  usedReferences  Json?            @map("used_references")
  model           String?
  status          GenerationStatus @default(success)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppProject RppProject @relation(fields: [rppProjectId], references: [id], onDelete: Cascade)

  exportedDocuments ExportedDocument[]
  ragRetrievalLogs  RagRetrievalLog[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@index([rppProjectId, updatedAt])
  @@map("generated_rpps")
}

model ExportedDocument {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  rppProjectId   String         @map("rpp_project_id") @db.Uuid
  generatedRppId String         @map("generated_rpp_id") @db.Uuid
  fileType       ExportFileType @map("file_type")
  fileName       String         @map("file_name")
  filePath       String         @map("file_path")
  fileUrl        String?        @map("file_url")
  mimeType       String         @map("mime_type")
  sizeBytes      Int            @map("size_bytes")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppProject   RppProject   @relation(fields: [rppProjectId], references: [id], onDelete: Cascade)
  generatedRpp GeneratedRpp @relation(fields: [generatedRppId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([rppProjectId, createdAt])
  @@index([generatedRppId, createdAt])
  @@map("exported_documents")
}

model RagRetrievalLog {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  rppProjectId   String? @map("rpp_project_id") @db.Uuid
  generatedRppId String? @map("generated_rpp_id") @db.Uuid
  query          Json?
  references     Json?
  source         String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rppProject   RppProject?   @relation(fields: [rppProjectId], references: [id], onDelete: Cascade)
  generatedRpp GeneratedRpp? @relation(fields: [generatedRppId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([rppProjectId, createdAt])
  @@index([generatedRppId, createdAt])
  @@map("rag_retrieval_logs")
}

enum UserRole {
  teacher
  admin
}

enum SchoolLevel {
  SD
  SMP
  SMA
  SMK
}

enum SchoolType {
  negeri
  swasta
}

enum RppType {
  intrakurikuler
  pjbl_kokurikuler
}

enum RppStatus {
  draft
  in_progress
  generated
  completed
  archived
}

enum ChatRole {
  user
  assistant
  system
}

enum DocumentType {
  capaian_pembelajaran
  panduan_kurikulum
  modul_ajar
  lainnya
}

enum GenerationStatus {
  success
  failed
  regenerated
}

enum ExportFileType {
  pdf
  docx
}
