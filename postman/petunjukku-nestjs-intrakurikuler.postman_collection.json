    {
      "name": "11 Recommend Stage 2 - CP + TP",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/rpp/projects/{{projectId}}/ai/stages/2/recommend",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "rpp",
