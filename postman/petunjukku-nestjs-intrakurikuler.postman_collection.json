      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const rec = json.recommendations || {};",
              "if (rec.capaianPembelajaran) pm.environment.set('stage2Cp', rec.capaianPembelajaran);",
              "if (Array.isArray(rec.tujuanPembelajaran)) pm.environment.set('stage2TpJson', JSON.stringify(rec.tujuanPembelajaran));",
              "pm.environment.set('stage2RecommendationJson', JSON.stringify(json));"
