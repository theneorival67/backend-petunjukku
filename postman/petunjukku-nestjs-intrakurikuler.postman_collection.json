    {
      "name": "03 Places Autocomplete - Pick School",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/autocomplete?input={{schoolSearchInput}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "autocomplete"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('Places autocomplete returns an array', () => pm.expect(json).to.be.an('array'));",
              "const first = json[0];",
              "if (first) {",
              "  pm.environment.set('schoolPlaceId', first.placeId);",
              "  pm.environment.set('schoolName', first.primaryText);",
              "  pm.environment.set('schoolSecondaryText', first.secondaryText || '');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Places Details - Save School Location",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/details?placeId={{schoolPlaceId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "details"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.placeId) pm.environment.set('schoolPlaceId', json.placeId);",
              "if (json.name) pm.environment.set('schoolName', json.name);",
              "if (json.city) pm.environment.set('schoolCity', json.city);",
              "if (json.province) pm.environment.set('schoolProvince', json.province);",
              "if (json.district) pm.environment.set('schoolDistrict', json.district);",
              "if (json.address) pm.environment.set('schoolAddress', json.address);",
              "if (json.latitude !== undefined) pm.environment.set('schoolLatitude', String(json.latitude));",
              "if (json.longitude !== undefined) pm.environment.set('schoolLongitude', String(json.longitude));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Places Nearby Environment - Save Context",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/places/nearby-environment?latitude={{schoolLatitude}}&longitude={{schoolLongitude}}&schoolName={{schoolName}}&radiusMeters=2000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "places",
            "nearby-environment"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.summary) pm.environment.set('schoolEnvironmentSummary', json.summary);",
              "if (Array.isArray(json.places)) pm.environment.set('nearbyPlacesJson', JSON.stringify(json.places));",
              "if (Array.isArray(json.risks)) pm.environment.set('environmentRisksJson', JSON.stringify(json.risks));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Upsert Teacher Profile - With Places",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/teacher-profile",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "teacher-profile"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function parseJsonEnv(key, fallback) {",
              "  const raw = pm.environment.get(key);",
              "  if (!raw) return fallback;",
              "  try { return JSON.parse(raw); } catch (e) { return fallback; }",
              "}",
              "",
              "function optionalNumber(key) {",
              "  const raw = pm.environment.get(key);",
              "  const value = Number(raw);",
              "  return Number.isFinite(value) ? value : undefined;",
              "}",
              "",
              "const nearbyPlaces = parseJsonEnv('nearbyPlacesJson', []);",
              "const environmentRisks = parseJsonEnv('environmentRisksJson', []);",
              "const latitude = optionalNumber('schoolLatitude');",
              "const longitude = optionalNumber('schoolLongitude');",
              "",
              "const body = {",
              "  fullName: 'Fauzan',",
              "  phone: '081234567890',",
              "  position: 'Guru Matematika',",
              "  educationLevel: 'S1 Pendidikan Matematika',",
              "  teachingExperienceYears: 5,",
              "  bio: 'Senang membuat pembelajaran kontekstual dan aktif.',",
              "  schoolName: pm.environment.get('schoolName') || 'SMP Negeri Contoh',",
              "  schoolCity: pm.environment.get('schoolCity') || 'Depok',",
              "  schoolProvince: pm.environment.get('schoolProvince') || 'Jawa Barat',",
              "  schoolDistrict: pm.environment.get('schoolDistrict') || undefined,",
              "  schoolAddress: pm.environment.get('schoolAddress') || undefined,",
              "  schoolPlaceId: pm.environment.get('schoolPlaceId') || undefined,",
              "  schoolLatitude: latitude,",
              "  schoolLongitude: longitude,",
              "  context: {",
              "    onboardingSource: 'places-postman',",
              "    schoolEnvironmentSummary: pm.environment.get('schoolEnvironmentSummary') || '',",
              "    nearbyPlaces,",
              "    environmentRisks,",
              "  },",
              "};",
              "",
              "Object.keys(body).forEach((key) => {",
              "  if (body[key] === undefined || body[key] === '') delete body[key];",
              "});",
              "",
              "pm.request.body.update(JSON.stringify(body, null, 2));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.profile?.id) pm.environment.set('teacherProfileId', json.profile.id);",
              "if (json.profile?.schoolId) pm.environment.set('schoolId', json.profile.schoolId);",
              "const subject = json.profile?.subjects?.[0];",
              "if (subject?.id && !pm.environment.get('teacherSubjectId')) pm.environment.set('teacherSubjectId', subject.id);",
              "const kelas = json.profile?.classes?.[0];",
              "if (kelas?.id && !pm.environment.get('teacherClassId')) pm.environment.set('teacherClassId', kelas.id);"
            ]
          }
        }
      ]
    },
