          "script": {
            "type": "text/javascript",
            "exec": [
              "const cp = pm.environment.get('stage2Cp') || 'Tempel CP dari request 11 di sini.';",
              "let tp = [];",
              "try { tp = JSON.parse(pm.environment.get(\"stage2TpJson\") || \"[]\"); } catch (e) { tp = []; }",
