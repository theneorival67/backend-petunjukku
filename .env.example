# # ─── App ───────────────────────────────────────────────────────
# # Gunakan 3001 jika port 3000 sudah dipakai aplikasi lain
# APP_PORT=3001
# NODE_ENV=development

# # ─── CORS ──────────────────────────────────────────────────────
# FRONTEND_URL=http://localhost:3002
# CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:5173,http://localhost:3001

# # ─── Prisma / Database ─────────────────────────────────────────
# # Supabase → Settings → Database → Connection string
# # PENTING: salin URI lengkap dari dashboard (bukan template dengan [kurung]).
# # Runtime: Transaction pooler (port 6543)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# # Migrate / db push: Direct (port 5432)
# DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# # ─── Supabase API ────────────────────────────────────────────────
# # Dashboard → Settings → API Keys
# # https://supabase.com/docs/guides/getting-started/api-keys
# # URL project (boleh SUPABASE_URL atau NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# # Publishable key — salah satu nama cukup:
# SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# # SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# # NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# # Secret key — salah satu nama cukup:
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# # SUPABASE_SECRET_KEY=sb_secret_...

# # Legacy (opsional): tab "Legacy anon, service_role" di dashboard yang sama
# # SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# # SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# # ─── Supabase Storage ──────────────────────────────────────────
# # SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
# # SUPABASE_STORAGE_BUCKET_AVATARS=avatars
# # SUPABASE_STORAGE_MAX_FILE_SIZE_MB=10

# # ─── Google Maps / Places (server-side, onboarding sekolah) ───
# # GCP → enable Places API (New) + Maps Static API
# # Key dibatasi di server (JANGAN pakai NEXT_PUBLIC di frontend)
# GOOGLE_MAPS_API_KEY=

# # ─── OpenCode Go (AI — server-side only) ───────────────────────
# # Langganan: https://opencode.ai/go → API key di https://opencode.ai/zen
# # Docs: https://opencode.ai/docs/go/
# #
# # PENTING:
# # - Key hanya di backend Nest (JANGAN di dash / NEXT_PUBLIC_*)
# # - Go ≠ Zen pay-as-you-go: base URL Go pakai /zen/go/v1 (bukan /zen/v1)
# # - Bisa pakai agent lain (OpenCode CLI, dll.) dengan key yang sama
# #
# # Aktifkan modul AI nanti (Pemindai Lingkungan kurasi, chat KINA)
# # AI_ENABLED=true

# # # API key dari console OpenCode (setelah subscribe Go)
# # OPENCODE_GO_API_KEY=

# # # Base URL OpenCode Go (jangan ubah kecuali dokumentasi resmi berubah)
# # OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# # Alias opsional (jika kode memakai nama generik)
# # OPENCODE_API_KEY=
# # OPENCODE_API_BASE_URL=https://opencode.ai/zen/go/v1

# # ── Pemindai lingkungan sekitar sekolah (murah, JSON) ───────────
# # Model Go: lihat /models di console atau https://opencode.ai/docs/go/
# # OpenAI-compatible → path chat/completions
# # Anthropic-compatible (Qwen, MiniMax) → path messages
# AI_ENV_MODEL=deepseek-v4-flash
# AI_ENV_API_PATH=chat/completions

# # ── Chat KINA (hemat kuota Go) ─────────────────────────────────
# # Perkiraan request / 5 jam (dok resmi Go): deepseek-v4-flash ~31k, qwen3.5-plus ~10k,
# # kimi-k2.6 ~1.1k. Model Qwen/MiniMax pakai path messages (bukan chat/completions).
# AI_CHAT_MODEL=deepseek-v4-flash
# AI_CHAT_API_PATH=chat/completions
# # Lebih kuat (lebih boros): deepseek-v4-pro, qwen3.6-plus + AI_CHAT_API_PATH=messages
# # AI_CHAT_MODEL=kimi-k2.6

# # Batas token output per request
# AI_MAX_TOKENS=2048

# # Timeout request ke OpenCode (ms)
# AI_REQUEST_TIMEOUT_MS=60000

# # ── Opsional: Zen pay-as-you-go (fallback di luar kuota Go) ───
# # Hanya jika di console Anda aktifkan "Use balance" setelah limit Go
# # OPENCODE_ZEN_API_KEY=
# # OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
# # OPENCODE_ZEN_ENV_MODEL=gpt-5-nano
# # OPENCODE_ZEN_CHAT_MODEL=claude-sonnet-4-5

# # ── Legacy (jangan dipakai jika sudah Go) ───────────────────────
# # OPENAI_API_KEY=sk-...

# # ─── JWT custom Nest (opsional, tidak dipakai untuk Supabase Auth) ─
# # JWT_SECRET=your-very-long-random-secret
# # JWT_EXPIRES_IN=7d
